{
  "name": "TextureEditPipeline",
  "vertex": { "shader": "../shaders/TextureEdit.wgsl", "entryPoint": "vs", "input": "pbr_static" },
  "fragment": { "shader": "../shaders/TextureEdit.wgsl", "entryPoint": "fs" },
  "primitive": { "topology": "triangle-list", "cullMode": "none" },
  "depthStencil": { "format": "depth24plus", "depthWriteEnabled": true, "depthCompare": "less" },
  "bindLayout": ["frame", "object", "textureEdit"],
  "renderer": {
    "query": ["MeshComponent", "CanvasComponent"],
    "phase": "Opaque",
    "target": { "color": "scene", "depth": "sceneDepth" },
    "geometry": {
      "steps": [{
        "vertexBuffers": [{ "slot": 0, "source": "meshSlots", "mesh": "MeshComponent.mesh" }],
        "indexBuffer": { "mesh": "MeshComponent.mesh" },
        "draw": { "type": "drawIndexed", "countField": "MeshComponent.indexCount" }
      }]
    },
    "bindGroups": [
      { "group": 1, "uniform": { "layoutRef": "perEntity", "writes": [
        { "member": "model", "value": "transform.model" }
      ] } },
      { "group": 2, "samplers": [{ "binding": 0, "name": "paint" }], "textures": [
        { "binding": 1, "source": "CanvasComponent.texHandle", "fallback": "white" }
      ] }
    ]
  }
}
